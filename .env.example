# Credenciales de Alpaca (https://app.alpaca.markets/)
# Para paper trading, genera las keys en el dashboard de "Paper Trading".
ALPACA_API_KEY=tu_api_key
ALPACA_SECRET_KEY=tu_secret_key

# Notificaciones de Telegram (opcionales). Si se dejan vacías o ausentes,
