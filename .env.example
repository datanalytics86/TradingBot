# Credenciales de Alpaca (https://app.alpaca.markets/)
# Para paper trading, genera las keys en el dashboard de "Paper Trading".
ALPACA_API_KEY=tu_api_key
ALPACA_SECRET_KEY=tu_secret_key

# Polygon.io (opcional, recomendado para scanner premarket y datos diarios).
# Plan gratuito: https://polygon.io/ — sin key, el bot usa Alpaca/yfinance.
POLYGON_API_KEY=

# Grok / xAI (opcional, para análisis IA del scanner premarket).
# Obtén tu key en: https://console.x.ai/team/default/api-keys
GROK_API_KEY=xai-tu_api_key_aqui

# Notificaciones de Telegram (opcionales). Si se dejan vacías o ausentes,
# el bot simplemente no envía notificaciones (no-op silencioso).
# Cómo crear el bot y obtener estos valores: ver sección "Notificaciones
# por Telegram" en el README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Confirmación obligatoria para modo live (config.yaml → mode: live).
# Sin esto, el bot se niega a operar con dinero real.
# TRADINGBOT_LIVE_CONFIRM=YES
